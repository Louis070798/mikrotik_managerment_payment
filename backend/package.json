{
  "name": "mikrotik-fleet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend/Platform for MikroTik Centralized Fleet Management — Inventory + Server Health module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:test": "tsx scripts/migrate.ts --env=.env.test",
    "seed:test": "tsx scripts/seed-test.ts --env=.env.test",
    "db:check": "drizzle-kit check",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.28.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "openapi-response-validator": "^12.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
