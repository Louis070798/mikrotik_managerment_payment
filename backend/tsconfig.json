{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "paths": {
      "@common/*": ["src/libs/common/*"],
      "@config/*": ["src/libs/config/*"],
      "@db/*": ["src/libs/db-control/*"],
      "@registry/*": ["src/libs/registry/*"],
      "@health-checks/*": ["src/libs/health-checks/*"],
      "@audit/*": ["src/libs/audit/*"],
      "@alerts-lib/*": ["src/libs/alerts/*"],
      "@auth-stub/*": ["src/libs/auth-stub/*"],
      "@telemetry-normalize/*": ["src/libs/telemetry-normalize/*"],
      "@collectors/*": ["src/libs/collectors/*"],
      "@radius-server/*": ["src/libs/radius-server/*"],
      "@netflow-collector/*": ["src/libs/netflow-collector/*"],
      "@dns-resolution-cache/*": ["src/libs/dns-resolution-cache/*"],
      "@dns-log-collector/*": ["src/libs/dns-log-collector/*"],
      "@secrets/*": ["src/libs/secrets/*"],
      "@inventory-cache/*": ["src/libs/inventory-cache/*"],
      "@password-hash/*": ["src/libs/password-hash/*"],
      "@radius-coa/*": ["src/libs/radius-coa/*"],
      "@debug-log/*": ["src/libs/debug-log/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
