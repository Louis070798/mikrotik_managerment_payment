# Safe local/test defaults only. Do not copy this file to production unchanged.
# Tier 0 bootstrap — ADR-04. Service addresses that the BACKEND CALLS OUT TO (analytics, storage,
# ZeroTier controller...) are configured through service_endpoints, not through process env vars.
#
# The RADIUS_* entries below are not that: they are ports this backend BINDS itself, plus two
# values used only to build the RouterOS command text shown in the UI (the server never dials
# RADIUS_SERVER_ADDRESS, and RADIUS_COA_PORT is the port the ROUTER listens on). They are settable
# from the Settings page, which writes them straight back into .env.
NODE_ENV=test
NODE_ROLE=api
PORT=3000
DATABASE_CONTROL_URL=postgres://fleet_app:fleet_dev_local_only@127.0.0.1:54329/fleet_control_test
LOG_LEVEL=info
HEALTH_SWEEP_INTERVAL_MS=15000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000
HEALTH_CHECK_MAX_RETRIES=2

# RADIUS server chay NGAY TRONG backend nay (libs/radius-server/), khong phai FreeRADIUS ngoai.
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
# Dia chi server nhu ROUTER nhin thay (thuong la IP ZeroTier) -- chi de sinh lenh "/radius add address=...".
RADIUS_SERVER_ADDRESS=
# Cong CoA/Disconnect ma ROUTER lang nghe (RFC 5176).
RADIUS_COA_PORT=3799
# 64 ky tu hex (32 byte). BAT BUOC co, neu khong moi thao tac dat/doc RADIUS secret deu tra 422.
# Sinh bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RADIUS_SECRET_ENCRYPTION_KEY=

# embedded = backend tu lam RADIUS server (mac dinh, giu nguyen hanh vi cu).
# freeradius = FreeRADIUS ben ngoai lam RADIUS that; backend KHONG bind 1812/1813 nua, chi doc
#              radacct qua DATABASE_AAA_URL va dong bo ve radius_sessions.
RADIUS_MODE=embedded
# PostgreSQL CUA FreeRADIUS (rlm_sql) -- khac han DATABASE_CONTROL_URL o tren. Bat buoc khi
# RADIUS_MODE=freeradius. Vd: postgres://radius:***@10.149.79.186:5432/radius
DATABASE_AAA_URL=

NETFLOW_PORT=2055
DNS_LOG_PORT=5514

# --- service_endpoints bootstrap (npm run services:register) ------------------
# docs/runbooks/server-bootstrap.md muc 4. Khong co migration/seed nao tao dong
# service_endpoints -> thieu buoc nay thi trang VPN ZeroTier bao ZEROTIER_NOT_CONFIGURED
# va crew/radius-health luon UNKNOWN. Script CHI dang ky service nao co du bien duoi day.

# ZeroTier controller -- dia chi ma BACKEND goi toi duoc (neu controller chay trong Docker
# khong publish port 9993 thi day la dia chi cua zt-api-proxy, KHONG phai 9993 truc tiep).
#ZEROTIER_CONTROLLER_HOST=127.0.0.1
#ZEROTIER_CONTROLLER_PORT=9993
#ZEROTIER_CONTROLLER_PROTOCOL=http

# RADIUS health probe -- gui Access-Request THAT toi FreeRADIUS.
# Can them 1 dong trong bang `nas` cho chinh IP cua backend voi dung secret nay, roi
# systemctl restart freeradius (clients chi duoc doc luc khoi dong).
#RADIUS_HEALTHCHECK_HOST=
#RADIUS_HEALTHCHECK_SECRET=
#RADIUS_HEALTHCHECK_USERNAME=healthcheck-probe
#RADIUS_HEALTHCHECK_PASSWORD=healthcheck-probe-password

# Health check DB mo ket noi SQL that -> can mat khau rieng (ADR-05: DB chi giu secret_ref,
# khong giu gia tri that; DATABASE_*_URL khong duoc dung lam secret cho health check).
#DATABASE_CONTROL_PASSWORD=
#DATABASE_AAA_PASSWORD=
